import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler

# Încărcarea datelor curățate
df = pd.read_csv('../data/gym_progress_cleaned.csv')
df = df.set_index('Date')

# Selectarea caracteristicilor de intrare (features) și a variabilei țintă (target)
features = ['Workout_Duration', 'Caloric_Intake', 'Protein_Intake']
target = ['Weight']

# Scalarea datelor în intervalul [0, 1] (esențial pentru stabilitatea rețelelor neuronale)
scaler_X = MinMaxScaler()
scaler_y = MinMaxScaler()

scaled_X = scaler_X.fit_transform(df[features])
scaled_y = scaler_y.fit_transform(df[target])

# Funcție pentru crearea secvențelor temporale (time-windows)
def create_sequences(X, y, time_steps=7):
    Xs, ys = [], []
    for i in range(len(X) - time_steps):
        Xs.append(X[i:(i + time_steps)])
        ys.append(y[i + time_steps])
    return np.array(Xs), np.array(ys)

# Setarea ferestrei de timp (ex: datele din ultimele 7 zile prezic ziua 8)
TIME_STEPS = 7
X, y = create_sequences(scaled_X, scaled_y, TIME_STEPS)

# Împărțirea datelor în seturi de antrenare (80%) și testare (20%)
train_size = int(len(X) * 0.8)
X_train, X_test = X[:train_size], X[train_size:]
y_train, y_test = y[:train_size], y[train_size:]

print(f"Forma X_train: {X_train.shape}") # (Samples, Time Steps, Features)
